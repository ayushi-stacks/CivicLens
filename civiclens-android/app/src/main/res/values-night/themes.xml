<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CivicLens" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/civiclens_navy</item>
        <item name="android:navigationBarColor">@color/civiclens_navy</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.CivicLens.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/civiclens_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/civiclens_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.CivicLens</item>
    </style>
</resources>
